{
  "author": "Community",
  "id": "com.community.discordserver",
  "name": "Discord Server",
  "description": "Shows who is in voice and who is online on your Discord server. Tap a voice channel to open it in Discord.",
  "version": "1.1.0",
  "preview_icon": "resources/icon.svg",
  "min_app_version": "5.52",
  "min_framework_version": "1.4.0",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd"
    }
  ],
  "interactive": true,
  "required_plugins": [
    "widgetbuilder.linkprovider:Url:1.0"
  ],
  "permissions": [
    {
      "type": "url",
      "domain": "discord.com"
    },
    {
      "type": "url",
      "domain": "discordapp.com"
    }
  ]
}
